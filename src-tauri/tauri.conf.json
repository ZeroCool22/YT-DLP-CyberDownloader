{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CyberDownloader",
  "version": "2.0.0",
  "identifier": "com.forowarez.cyberdownloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YT-DLP CyberDownloader v2.0",
        "width": 1040,
        "height": 720,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0f0f13"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "resources": {
      "../tools/yt-dlp.exe": "tools/yt-dlp.exe",
      "../tools/ffmpeg.exe": "tools/ffmpeg.exe",
      "../tools/ffprobe.exe": "tools/ffprobe.exe",
      "../tools/SHA2-256SUMS": "tools/SHA2-256SUMS"
    }
  }
}
